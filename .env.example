# Copy to .env.local for local development. Never commit real values.
# Values come from `npm run db:start` (local) or the Supabase dashboard (hosted).
# Use only the PUBLISHABLE/anon key here. The service-role key must never reach the browser
# or this repository.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
